# ─────────────────────────────────────────────────────────────
# PopTheLogo environment variables
# Copy this file to `.env.local` and fill in your values.
# ─────────────────────────────────────────────────────────────

# Supabase project (https://app.supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never expose to the client.
# Used by admin write operations. Leave empty to run in read-only fallback mode.
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel password (choose your own strong password)
ADMIN_PASSWORD=change-me-now

# Secret used to sign the admin session JWT (any long random string)
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Public site URL (used for canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
